# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit it.
# See CLAUDE.md for the full spec these map to.

# ── Supabase (Postgres + Storage) ──────────────────────────────────────────

# Project URL. Safe for the browser: Supabase project URLs aren't secret.
# Supabase dashboard → Project Settings → Data API → Project URL.
NEXT_PUBLIC_SUPABASE_URL=

# Public "anon" key. Safe for the browser: access is enforced by Row Level
# Security policies on the tables/buckets, not by keeping this key secret.
# Supabase dashboard → Project Settings → API Keys → anon public.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key. SERVER-ONLY — bypasses Row Level Security entirely.
# Used only inside API routes (creating donations, minting presigned Storage
# upload URLs, etc). Never send this to the browser.
# Supabase dashboard → Project Settings → API Keys → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=

# ── Stripe (test mode) — optional, demo mode skips payment entirely ───────

# Publishable key. Safe for the browser: it can only create, never charge.
# Used client-side to mount the embedded Payment Element sheet on screen 4.
# Stripe dashboard → Developers → API keys → Publishable key (starts pk_test_).
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Secret key. SERVER-ONLY — can create charges and PaymentIntents.
# Used in /api/payment-intent to create the PaymentIntent for the quoted amount.
# Stripe dashboard → Developers → API keys → Secret key (starts sk_test_).
STRIPE_SECRET_KEY=

# Webhook signing secret. SERVER-ONLY — verifies that /api/webhooks/stripe
# payloads actually came from Stripe before trusting a payment as confirmed.
# Stripe dashboard → Developers → Webhooks → your endpoint → Signing secret
# (starts whsec_). Locally, the Stripe CLI (`stripe listen`) prints its own.
STRIPE_WEBHOOK_SECRET=

# ── Uber Direct ─────────────────────────────────────────────────────────

# OAuth client ID. SERVER-ONLY — used to fetch the bearer token used against
# every Uber Direct endpoint. Sandbox and production share the same
# endpoints; this is the credential that decides which one you hit.
# direct.uber.com → Management → Developer → click "Switch to testing" for
# the sandbox credential set (production is shown by default).
UBER_CLIENT_ID=

# OAuth client secret. SERVER-ONLY — paired with UBER_CLIENT_ID for the
# client_credentials token request.
# direct.uber.com → Management → Developer (same screen as client ID).
UBER_CLIENT_SECRET=

# Customer ID. SERVER-ONLY — identifies your Uber Direct account; forms
# part of every API URL: /v1/customers/{customer_id}/...
# direct.uber.com → Management → Developer.
UBER_CUSTOMER_ID=

# Webhook signing key. SERVER-ONLY — a DIFFERENT secret from the client
# secret above. Used to HMAC-SHA256-verify the raw body of incoming
# /api/webhooks/uber requests via the x-uber-signature header.
# direct.uber.com → Developer → Webhooks tab.
UBER_WEBHOOK_SIGNING_KEY=

# DEV-ONLY escape hatch: set to "1" to make /api/webhooks/uber skip
# signature verification, so scripts/replay-uber-webhook.mjs can post
# unsigned synthetic payloads without needing the real signing key. Only
# takes effect when NODE_ENV isn't "production" — leave unset unless you're
# actively replaying webhooks locally.
UBER_WEBHOOK_SKIP_SIGNATURE_CHECK=

# ── Geoapify (address autocomplete) ────────────────────────────────────

# API key. SERVER-ONLY — proxied through /api/places/search so the key
# never reaches the browser. Free tier, ~3,000 requests/day, no card.
# Sign up at myprojects.geoapify.com, then Projects → your project → API key.
GEOAPIFY_API_KEY=

# ── Overpass API (OpenStreetMap charity lookup) ────────────────────────

# No API key — Overpass is free, unauthenticated community infrastructure.
# It does require a descriptive User-Agent identifying this app and a
# contact, per their usage policy. Not a secret, just server-side config.
# Anything identifying, e.g. "SendItAlong/1.0 (you@example.com)".
OVERPASS_USER_AGENT=

# ── Resend (email) ──────────────────────────────────────────────────────

# API key. SERVER-ONLY — used to send the "email me a copy" receipt.
# Resend dashboard → API Keys → Create API Key.
RESEND_API_KEY=

# Verified "from" address for outgoing receipt emails. Not a secret, but
# only used server-side. Must be on a domain verified in Resend.
# Resend dashboard → Domains, once a domain is verified.
RESEND_FROM_EMAIL=

# ── App config ───────────────────────────────────────────────────────────

# This deploy's public URL. Safe for the browser. Used to build absolute
# links (e.g. the /r/:id receipt link inside emails) and as the dropoff
# webhook base when registering with Uber.
# Your Vercel deployment URL, or http://localhost:3000 in dev.
NEXT_PUBLIC_APP_URL=

# Demo mode toggle. Safe for the browser — it only gates UI copy and skips
# Stripe; the actual "never dispatch before payment resolves" ordering
# still holds in code either way. Also toggleable per-request via ?demo=1.
# Set to "true" to always demo on this deploy, "false" (or unset) otherwise.
NEXT_PUBLIC_DEMO_MODE=
